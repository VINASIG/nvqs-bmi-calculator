---
import SiteFooter from './SiteFooter.astro';
import '../styles/site-chrome.css';
import { Calculator, Trash } from '@lucide/astro';
import ThemeInit from './ThemeInit.astro';
import SitePreferences from './SitePreferences.astro';
import { copy, sources } from '../lib/military-copy.ts';
import { sourceTable } from '../lib/military.ts';
import type { Locale } from '../lib/math.ts';
import '../styles/tokens.css';
import '../styles/app.css';
import '../styles/control-surfaces.css';
import '../styles/destructive-actions.css';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = copy[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const root = 'https://nvqs-bmi.vinasig.io.vn/';
const canonical = root + (lang === 'en' ? 'en/' : '');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.title,
  url: canonical,
  description: c.description,
  inLanguage: lang,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web browser',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: 'VINASIG',
    url: 'https://github.com/VINASIG',
  },
};
const mainFields = [
  {
    id: 'height',
    label: c.height,
    placeholder: c.heightExample,
    required: true,
  },
  {
    id: 'weight',
    label: c.weight,
    placeholder: c.weightExample,
    required: true,
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{c.title} | VINASIG</title>
    <meta name="description" content={c.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="vi" href={root} />
    <link rel="alternate" hreflang="en" href={`${root}en/`} />
    <link rel="alternate" hreflang="x-default" href={root} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${c.title} | VINASIG`} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href={`${base}brand/mark.svg`} />
    {[16, 32, 48].map((size) => (
      <link
        rel="icon"
        type="image/png"
        sizes={`${size}x${size}`}
        href={`${base}brand/favicon-${size}.png`}
      />
    ))}
    <link
      rel="preload"
      href={`${base}fonts/SpaceGrotesk-VariableFont_wght.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={`${base}fonts/font.css`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <ThemeInit />
  </head>
  <body data-tool="military" data-language={lang}>
    <a class="skip-link" href="#calculator">
      {c.skip}
    </a>
    <div class="app-shell" data-site-shell>
      <header class="site-header" data-site-header>
        <a
          class="brand"
          href="https://vinasig.io.vn/"
          aria-label={c.brandHome}
          data-brand-logo
        >
          <picture>
            <source
              media="(prefers-color-scheme: dark)"
              srcset={`${base}brand/reversed.svg`}
            />
            <script is:inline>
              document.currentScript?.previousElementSibling?.setAttribute(
                'media',
                document.documentElement.dataset.theme === 'dark'
                  ? 'all'
                  : 'not all',
              );
            </script>
            <img
              src={`${base}brand/primary-color.svg`}
              width="540"
              height="140"
              alt="VINASIG"
            />
          </picture>
        </a>
        <SitePreferences
          lang={lang}
          alternate={lang === 'vi' ? `${base}en/` : base}
        />
      </header>
      <main>
        <div class="intro">
          <h1>{c.title}</h1>
          <p class="lead">{c.lead}</p>
          <p>{c.intro}</p>
        </div>
        <div class="workspace" id="calculator">
          <section class="editor" aria-labelledby="form-heading">
            <h2 id="form-heading">{c.formTitle}</h2>
            <form id="bmi-form" novalidate autocomplete="off">
              <fieldset id="table" class="table-field">
                <legend>{c.table}</legend>
                <div class="table-options">
                  <label class="table-option">
                    <input
                      id="table-male"
                      type="radio"
                      name="physique-table"
                      value="male"
                      checked
                      disabled
                    />
                    <span>{c.male}</span>
                  </label>
                  <label class="table-option">
                    <input
                      id="table-female"
                      type="radio"
                      name="physique-table"
                      value="female"
                      disabled
                    />
                    <span>{c.female}</span>
                  </label>
                </div>
              </fieldset>
              <p class="supporting measurement-fields" id="bmi-formula">
                {c.bmiFormula}
              </p>
              <div class="fields measurement-fields">
                {mainFields.map((field) => (
                  <div class="field" id={`${field.id}-field`}>
                    <label for={field.id}>{field.label}</label>
                    <input
                      id={field.id}
                      type="text"
                      inputmode="decimal"
                      maxlength="12"
                      placeholder={field.placeholder}
                      required={field.required}
                      disabled
                      aria-describedby={`bmi-formula measurement-hint ${field.id}-error`}
                    />
                    <p class="field-error" id={`${field.id}-error`} hidden></p>
                  </div>
                ))}
              </div>
              <p class="supporting" id="measurement-hint">
                {c.hint}
              </p>
              <p class="supporting">{c.automatic}</p>
              <button type="submit" hidden disabled data-enter-submit>
                {lang === 'vi' ? 'Kiểm tra số đo' : 'Check measurements'}
              </button>
              <div class="field result-section" id="chest-field">
                <label for="chest">{c.chest}</label>
                <p class="supporting" id="chest-hint">
                  {c.chestHint}
                </p>
                <input
                  id="chest"
                  type="text"
                  inputmode="decimal"
                  maxlength="12"
                  placeholder={c.chestExample}
                  disabled
                  aria-describedby="chest-hint measurement-hint chest-error"
                />
                <p class="field-error" id="chest-error" hidden></p>
              </div>
              <div class="form-actions">
                <button
                  id="clear"
                  type="reset"
                  class="clear-button"
                  disabled
                  data-destructive-action
                >
                  <Trash size={18} aria-hidden="true" />
                  <span>{c.clear}</span>
                </button>
              </div>
              <p class="supporting privacy">{c.privacy}</p>
              <p
                class="status supporting"
                id="status"
                role="status"
                aria-live="polite"
              ></p>
              <noscript>
                <p>{c.noScript}</p>
              </noscript>
            </form>
          </section>
          <section class="preview" aria-labelledby="result-heading">
            <h2 id="result-heading" tabindex="-1">
              {c.resultTitle}
            </h2>
            <div id="empty-result" class="empty-result">
              <Calculator size={32} aria-hidden="true" />
              <p>{c.empty}</p>
            </div>
            <div id="result" hidden>
              <p class="bmi-value">
                <span id="bmi-value"></span>
                <span class="bmi-unit">kg/m²</span>
              </p>
              <p id="drivers"></p>
              <p id="missing-chest" class="supporting" hidden>
                {c.missing}
              </p>
              <p id="physique-criterion"></p>
              <p id="bmi-criterion"></p>
              <p id="low-gap" hidden>
                {c.lowGap}
              </p>
              <p id="table-gap" class="supporting" hidden>
                {c.tableGap}
              </p>
              <p class="supporting">
                <a href={sources.recruitment}>Thông tư 68/2025/TT-BQP</a> -{' '}
                <a href={sources.physique}>Thông tư 105/2023/TT-BQP</a>
              </p>
              <details id="scoring-explanation">
                <summary>{c.scoringTitle}</summary>
                <p>{c.scoringIntro}</p>
                <ul id="score-list" class="score-list"></ul>
                <p>{c.physiqueRule}</p>
                <p>{c.rounding}</p>
              </details>
              <details id="bmi-explanation">
                <summary>{c.bmiExplanation}</summary>
                <p>{c.bmiNote}</p>
                <p>
                  {c.exact} <span id="exact-bmi"></span>
                </p>
              </details>
              <section
                class="result-section result-summary"
                aria-labelledby="conclusion-heading"
              >
                <h3 id="conclusion-heading">{c.conclusionTitle}</h3>
                <p class="category" id="category"></p>
                <p class="supporting" id="conclusion-scope"></p>
              </section>
            </div>
            <p class="result-scope">{c.limitation}</p>
          </section>
          <div id="result-details" class="workspace-addendum" hidden>
            <div class="result-grid">
              <section
                class="result-section"
                aria-labelledby="boundary-heading"
              >
                <h3 id="boundary-heading">{c.boundaryTitle}</h3>
                <p class="supporting">{c.boundaryNote}</p>
                <p id="threshold-distance"></p>
                <p id="boundary-warning"></p>
              </section>
              <section class="result-section" aria-labelledby="advice-heading">
                <h3 id="advice-heading">{c.adviceTitle}</h3>
                <p>
                  {c.reference} <strong id="weight-range"></strong>
                </p>
                <p id="weight-change"></p>
                <p id="health-advice"></p>
                <p class="supporting">{c.healthScope}</p>
                <p class="supporting">{c.adviceDisclaimer}</p>
                <details id="weight-method">
                  <summary>{c.weightMethod}</summary>
                  <p>{c.referenceNote}</p>
                  <p id="weight-distance"></p>
                </details>
              </section>
            </div>
          </div>
        </div>
        <div class="notes">
          <details id="table-details">
            <summary>{c.tableTitle}</summary>
            <p>{c.tableIntro}</p>
            <section
              class="table-scroll"
              tabindex="0"

              aria-label={c.tableCaption}
            >
              <table>
                <caption>{c.tableCaption}</caption>
                <thead>
                  <tr>
                    {c.headers.map((header) => (
                      <th scope="col">{header}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {sourceTable.map((row) => (
                    <tr>
                      {row.map((cell, index) =>
                        index === 0 ? (
                          <th scope="row">{cell}</th>
                        ) : (
                          <td>
                            {lang === 'en'
                              ? cell.replace('hoặc', 'or').replaceAll(',', '.')
                              : cell}
                          </td>
                        ),
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
            <p>{c.rounding}</p>
            <p>
              <a href={sources.physique}>Thông tư 105/2023/TT-BQP</a> -{' '}
              <a href={sources.amendment}>
                {lang === 'vi' ? 'Thông tư' : 'Circular'} 106/2025/TT-BQP
              </a>
            </p>
            <p class="supporting">{c.reviewed}</p>
          </details>
          <details id="legal-details">
            <summary>{c.legalTitle}</summary>
            <p>{c.legalText}</p>
            <p>{c.lowGap}</p>
            <p>{c.examText}</p>
            <p>
              <a href={sources.recruitment}>Thông tư 68/2025/TT-BQP</a> -{' '}
              <a href={sources.review}>
                {lang === 'vi'
                  ? 'Hướng dẫn của Bộ Quốc phòng'
                  : 'Ministry of Defence guidance'}
              </a>
            </p>
          </details>
          <details id="rights-details">
            <summary>{c.rightsTitle}</summary>
            <p>{c.rightsLaw}</p>
            <p>{c.disclosure}</p>
            <p>{c.complaint}</p>
            <p>
              <a href={sources.law}>
                {lang === 'vi'
                  ? 'Luật Nghĩa vụ quân sự hiện hành - bản hợp nhất 133/2026'
                  : 'Current law - consolidated text 133/2026'}
              </a>{' '}
              - <a href={sources.recruitment}>Thông tư 68/2025/TT-BQP</a> -{' '}
              <a href={sources.review}>
                {lang === 'vi'
                  ? 'Hướng dẫn giám định sức khỏe'
                  : 'Medical assessment guidance'}
              </a>
            </p>
            <p class="supporting">{c.englishNote}</p>
          </details>
          <details>
            <summary>{c.adviceTitle}</summary>
            <p>{c.underAdvice}</p>
            <p>{c.overAdvice}</p>
            <p>{c.adviceDisclaimer}</p>
            <p>
              <a href={sources.health}>
                {lang === 'vi'
                  ? 'Cách tăng cân lành mạnh của NHS'
                  : 'Healthy weight gain from NHS'}
              </a>
            </p>
          </details>
          <details>
            <summary>{c.privacyTitle}</summary>
            <p>{c.privacyText}</p>
          </details>
        </div>
        <section class="tool-choice" aria-labelledby="choice-heading">
          <h2 id="choice-heading">{c.chooseTitle}</h2>
          <p>{c.chooseMilitary}</p>
          <p>{c.chooseAdult}</p>
          <a
            id="other-tool"
            href={`https://bmi.vinasig.io.vn/${lang === 'en' ? 'en/' : ''}`}
          >
            {c.otherLink}
          </a>
        </section>
      </main>
      <SiteFooter
        lang={lang}
        source="https://github.com/VINASIG/nvqs-bmi-calculator"
        issues="https://github.com/VINASIG/nvqs-bmi-calculator/issues"
        licenses={`${base}licenses/NOTICE.txt`}
      />
    </div>
    <script>
      import '../scripts/military-calculator.ts';
    </script>
  </body>
</html>
